rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🌐 Colección GLOBAL del catálogo de ejercicios (ExerciseDB → Firestore).
    // Compartida por todos los atletas: cualquiera autenticado puede leerla.
    // La escritura autenticada es necesaria porque la siembra inicial
    // (ExerciseCatalogSeeder) corre desde el cliente.
    // En producción: restringir a `allow create` con validación de campos
    // o migrar la siembra a Admin SDK y dejar `allow write: if false`.
    match /exercises/{exerciseId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // 🔒 Datos privados del atleta: aislados bajo /users/{userId}
    // (perfil, rutinas, sesiones, competencias, equipo, ejercicios personalizados).
    // Regla de seguridad de agent.md: request.auth.uid == userId.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
